# DeepSpace — Next.js Frontend Dockerfile
# Multi-stage build for production

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY packages/shared-types/tsconfig.json ./packages/shared-types/tsconfig.json
COPY apps/studio-web/package.json ./apps/studio-web/package.json
COPY apps/studio-web/tsconfig.json ./apps/studio-web/tsconfig.json
COPY apps/studio-web/next.config.ts ./apps/studio-web/next.config.ts
COPY apps/studio-web/postcss.config.mjs ./apps/studio-web/postcss.config.mjs

RUN pnpm install --frozen-lockfile

COPY packages/shared-types/src ./packages/shared-types/src
COPY apps/studio-web/src ./apps/studio-web/src
COPY apps/studio-web/public ./apps/studio-web/public

ARG NEXT_PUBLIC_API_URL=http://localhost:3002
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @deepspace/shared-types build
RUN pnpm --filter @deepspace/studio-web build

# Flatten node_modules for production (eliminates pnpm symlinks)
RUN pnpm --filter @deepspace/studio-web --prod deploy /app/prod

FROM node:22-alpine

WORKDIR /app

COPY --from=builder /app/prod/node_modules ./node_modules
COPY --from=builder /app/prod/.next ./.next
COPY --from=builder /app/prod/package.json ./package.json
COPY --from=builder /app/prod/public ./public
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist

EXPOSE 3000

CMD ["node_modules/.bin/next", "start"]